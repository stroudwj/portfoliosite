---
// Server-side logic: Astro grabs the current live URL path
const currentPath = Astro.url.pathname;
---

<div class="mac-dock-vertical">
  <!-- Dynamic template literals seamlessly apply the active underline class -->
  <a href="/" class={`dock-link ${currentPath === '/' ? 'active' : ''}`}><span class="dock-item">Graphic Design</span></a>
  <a href="/photography" class={`dock-link ${currentPath === '/photography' || currentPath === '/photography/' ? 'active' : ''}`}><span class="dock-item">Photography</span></a>
  <a href="/art" class={`dock-link ${currentPath === '/art' || currentPath === '/art/' ? 'active' : ''}`}><span class="dock-item">Art</span></a>
  <a href="/bio" class={`dock-link ${currentPath === '/bio' || currentPath === '/bio/' ? 'active' : ''}`}><span class="dock-item">Bio</span></a>
</div>

<style>
.mac-dock-vertical {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 15px;
  background: transparent;
}

.dock-link {
  display: flex;
  align-items: center;      
  text-decoration: none;    
  background: transparent;
  margin: 0;
  padding-top: 3px;   
  padding-bottom: 3px;
  -webkit-tap-highlight-color: transparent; /* Remove default mobile tap highlight */
}

.dock-item {
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 0.7rem;        
  font-weight: 700;         
  color: #333333;           
  letter-spacing: 0.3px;    
  white-space: nowrap;
  display: inline-block;
  transform-origin: left center; 
  position: relative;
}

/* Underline setup */
.dock-item::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 100%;
  height: 2px;
  background-color: #000000;
  transform: scaleX(0);
  transition: transform 0.2s ease;
  transform-origin: left center;
}

/* Active page gets underlined globally */
.dock-link.active .dock-item::after {
  transform: scaleX(1);
  background-color: #000000;
}
.dock-link.active .dock-item {
  color: #000000;
}

/* Desktop Styles (Devices with hover capability) */
@media (hover: hover) {
  .dock-link { transition: padding 0.28s cubic-bezier(0.25, 1, 0.5, 1); }
  .dock-item { transition: transform 0.28s cubic-bezier(0.25, 1, 0.5, 1), color 0.2s ease; will-change: transform; }
  /* Allow active underline on desktop */
  .dock-link.active .dock-item::after { transform: scaleX(1); }
}

/* Mobile / Touch Styles (Devices without hover capability) */
@media (hover: none) {
  .dock-link { 
    padding-top: 12px !important; 
    padding-bottom: 12px !important; 
  }
  
  /* Show underline when actively tapping/clicking a link */
  .dock-link:active .dock-item::after { 
    transform: scaleX(1); 
  }
  
  /* Ensure text color changes on tap */
  .dock-link:active .dock-item {
    color: #000000;
  }
  
  /* Active page stays underlined (overriding just in case) */
  .dock-link.active .dock-item::after { 
    transform: scaleX(1); 
  }
}
</style>

<script>
// This client-side script runs perfectly on desktop windows
const container = document.querySelector('.mac-dock-vertical');
const links = document.querySelectorAll('.dock-link');
const isDesktop = window.matchMedia('(hover: hover)').matches;

if (isDesktop && container) {
  links.forEach((activeLink, index) => {
    activeLink.addEventListener('mouseenter', () => {
      links.forEach((link, idx) => {
        const item = link.querySelector('.dock-item') as HTMLElement;
        const currentLink = link as HTMLElement;
        if (!item) return;

        if (idx === index) {
          item.style.transform = 'scale(1.8)';
          item.style.color = '#000000';
          currentLink.style.paddingTop = '12px';
          currentLink.style.paddingBottom = '12px';
        } else if (Math.abs(idx - index) === 1) {
          item.style.transform = 'scale(1.25)';
          item.style.color = '#666666';
          currentLink.style.paddingTop = '6px';
          currentLink.style.paddingBottom = '6px';
        } else {
          item.style.transform = 'scale(1)';
          item.style.color = '#999999';
          currentLink.style.paddingTop = '3px';
          currentLink.style.paddingBottom = '3px';
        }
      });
    });
  });

  container.addEventListener('mouseleave', () => {
    links.forEach(link => {
      const item = link.querySelector('.dock-item') as HTMLElement;
      const currentLink = link as HTMLElement;
      if (item) {
        item.style.transform = 'scale(1)';
        item.style.color = '#333333';
      }
      if (currentLink) {
        currentLink.style.paddingTop = '3px';
        currentLink.style.paddingBottom = '3px';
      }
    });
  });
}
</script>