---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import reachoutThumb from '../assets/graphic-design/reachout/thumbnails/thumbnail.jpg';
import astroblocThumb from '../assets/graphic-design/astrobloc/thumbnails/thumbnail.jpg';
import dailyPosterThumb from '../assets/graphic-design/daily-poster/thumbnails/thumbnail.jpg';
import magazineThumb from '../assets/graphic-design/magazine/thumbnail/finalmagv2.jpg';
import fliersThumb from '../assets/graphic-design/fliers/thumbnails/thumbnail.jpg';
import miscellaneousThumb from '../assets/graphic-design/miscellaneous/thumbnails/thumbnail.png';
---

<Layout title="Graphic Design — Portfolio" showLogo={true}>
  <div class="projects-container">
    <a href="/reachout" class="project-card">
      <div class="project-image-placeholder">
        <Image src={reachoutThumb} alt="Reachout Thumbnail" />
      </div>
      <div class="project-info">
        <h2 class="project-title">Reachout</h2>
      </div>
    </a>
    
    <a href="/astrobloc" class="project-card">
      <div class="project-image-placeholder">
        <Image src={astroblocThumb} alt="Astrobloc Thumbnail" />
      </div>
      <div class="project-info">
        <h2 class="project-title">Astrobloc</h2>
      </div>
    </a>

    <a href="/fliers" class="project-card">
      <div class="project-image-placeholder">
        <Image src={fliersThumb} alt="Fliers Thumbnail" />
      </div>
      <div class="project-info">
        <h2 class="project-title">Fliers</h2>
      </div>
    </a>

    <a href="/magazine" class="project-card">
      <div class="project-image-placeholder">
        <Image src={magazineThumb} alt="Magazine Thumbnail" />
      </div>
      <div class="project-info">
        <h2 class="project-title">Magazine</h2>
      </div>
    </a>

   <a href="/daily-poster" class="project-card">
      <div class="project-image-placeholder">
        <Image src={dailyPosterThumb} alt="Daily Poster Thumbnail" />
      </div>
      <div class="project-info">
        <h2 class="project-title">Daily Poster (mostly art)</h2>
      </div>
    </a>

    <a href="/miscellaneous" class="project-card">
      <div class="project-image-placeholder">
        <Image src={miscellaneousThumb} alt="Miscellaneous Thumbnail" />
      </div>
      <div class="project-info">
        <h2 class="project-title">Miscellaneous</h2>
      </div>
    </a>
  </div>
</Layout>

<style>
  .page-header {
    padding: 80px;
    margin-bottom: 60px;
  }
  
  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: #111;
    margin: 0;
    letter-spacing: -0.02em;
    text-align: right; /* Move title out of the way of the nav bar for full bleed */
  }

  .projects-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    width: 100%;
    margin-top: 180px;
  }

  .project-card {
    display: flex;
    align-items: stretch;
    width: 100%;
    min-height: 40vh; /* Make them decently tall */
    background-color: #f5f5f5; /* Light grey */
    text-decoration: none;
    overflow: hidden;
    transition: background-color 0.2s ease;
  }

  /* Hover effect: background changes to darker grey */
  .project-card:hover {
    background-color: #e5e5e5; /* Grey */
  }

  /* Left side: Image */
  .project-image-placeholder {
    width: 40%;
    background-color: #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-image-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Right side: Text */
  .project-info {
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
  }

  .project-title {
    margin: 0 0 8px 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: #000;
  }

  /* Responsive layout for smaller screens */
  @media (max-width: 1024px) {
    .projects-container {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 768px) {
    .project-card {
      width: 100%;
      min-width: 0;
      min-height: 25vh;
    }
    .project-info {
      padding: 20px;
    }
  }
</style>