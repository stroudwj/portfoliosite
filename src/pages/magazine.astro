---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import page02 from '../assets/graphic-design/magazine/images/02.jpg';
import page03 from '../assets/graphic-design/magazine/images/03.jpg';
import page04 from '../assets/graphic-design/magazine/images/04.jpg';
import page05 from '../assets/graphic-design/magazine/images/05.jpg';
import page06 from '../assets/graphic-design/magazine/images/06.jpg';
import page07 from '../assets/graphic-design/magazine/images/07.jpg';

const pages = [
  { src: page02, alt: 'Magazine page 02' },
  { src: page03, alt: 'Magazine page 03' },
  { src: page04, alt: 'Magazine page 04' },
  { src: page05, alt: 'Magazine page 05' },
  { src: page06, alt: 'Magazine page 06' },
  { src: page07, alt: 'Magazine page 07' },
];
---

<Layout title="Magazine — Portfolio" showLogo={true}>
  <div class="page-content-wrapper">
    <div class="project-header">
    </div>

    <div class="image-grid">
      {pages.map((page) => (
        <button class="grid-item lightbox-trigger" type="button" data-full-src={page.src.src}>
          <Image src={page.src} alt={page.alt} width={900} />
        </button>
      ))}
    </div>
  </div>

  <div id="image-modal" class="modal" role="dialog" aria-hidden="true">
    <span class="close-btn">&times;</span>
    <img id="modal-img" src="" alt="Full resolution magazine page" />
  </div>
</Layout>

<style>
  .page-content-wrapper {
    padding: 200px 40px 40px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .project-header {
    margin-bottom: 2rem;
  }

  .project-title {
    font-size: 3rem;
    font-weight: 800;
    margin: 0;
    color: #111;
    letter-spacing: -0.03em;
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  .grid-item {
    padding: 0;
    border: 0;
    background: transparent;
    width: 100%;
    display: block;
    cursor: zoom-in;
  }

  .grid-item :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.3s ease;
  }

  .grid-item:hover :global(img) {
    transform: scale(1.02);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
  }

  .modal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(8px);
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .modal.show {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }

  .modal img {
    max-width: 90vw;
    max-height: 85vh;
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    object-fit: contain;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .modal.show img {
    transform: scale(1);
  }

  .close-btn {
    position: absolute;
    top: 25px;
    right: 35px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 44px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, transform 0.2s ease;
    z-index: 10000;
    user-select: none;
  }

  .close-btn:hover {
    color: #fff;
    transform: scale(1.1);
  }

  @media (max-width: 768px) {
    .page-content-wrapper {
      padding: 80px 20px 40px;
    }

    .image-grid {
      grid-template-columns: 1fr;
    }

    .project-title {
      font-size: 2rem;
    }
  }
</style>

<script>
  function setupLightbox() {
    const modal = document.getElementById('image-modal');
    const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
    const closeBtn = document.querySelector('.close-btn');
    const triggers = document.querySelectorAll('.lightbox-trigger');

    if (!modal || !modalImg || !closeBtn) return;

    const openModal = (src: string) => {
      modalImg.src = src;
      modal.classList.add('show');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      modal.classList.remove('show');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!modal.classList.contains('show')) modalImg.src = '';
      }, 300);
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        const target = event.currentTarget as HTMLElement;
        const fullSrc = target.getAttribute('data-full-src');
        if (fullSrc) openModal(fullSrc);
      });
    });

    closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('show')) closeModal();
    });
  }

  document.addEventListener('DOMContentLoaded', setupLightbox);
  document.addEventListener('astro:page-load', setupLightbox);
</script>
