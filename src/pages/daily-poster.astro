---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import InteractiveWidget from '../components/InteractiveWidget.astro';

// Automatically grabs every image in the daily-poster folder
const imageFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/daily-poster/*.{jpg,jpeg,png,webp,gif}', { eager: true });

// Process the files into an array we can sort
const posters = Object.entries(imageFiles).map(([path, module]) => {
  // Extract the filename (e.g., "82.jpg") from the full path
  const filename = path.split('/').pop() || '';
  
  // Extract just the number from the filename (e.g., "82")
  const match = filename.match(/(\d+)/);
  const num = match ? parseInt(match[0], 10) : 0;

  return {
    num,
    path, // Keep track of the original file path to check extensions
    src: module.default, 
  };
});

// Sort the array in descending order (highest number first)
posters.sort((a, b) => b.num - a.num);
---

<Layout title="Daily Poster — Portfolio">
  <div class="widget-hero">
    <div class="project-header">
      <h1 class="project-title">Daily Poster</h1>
    </div>
    <div class="widget-wrapper">
      <InteractiveWidget />
    </div>
  </div>

  <div class="daily-poster-container">
    <div class="poster-grid">
      {posters.map((poster) => (
        <div class="poster-item">
          {poster.path.endsWith('.gif') ? (
            <!-- Standard HTML img for GIFs to preserve animation and avoid optimization crashes -->
            <img src={poster.src.src} alt={`Daily Poster ${poster.num}`} loading="lazy" />
          ) : (
            <!-- Astro's optimized Image component for static images -->
            <Image 
              src={poster.src} 
              alt={`Daily Poster ${poster.num}`} 
              width={800} 
            />
          )}
        </div>
      ))}
      
      <!-- Show a placeholder message if the folder is empty -->
      {posters.length === 0 && (
        <p style="grid-column: 1 / -1; color: #666;">
          Images will appear here once placed in <code>src/assets/daily-poster/</code>.
        </p>
      )}
    </div>
  </div>
</Layout>

<style>
  .widget-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100vh;
    width: 100%;
    padding-left: 12vw;
    padding-right: 8vw;
    box-sizing: border-box;
  }

  .widget-wrapper {
    height: 100%;
  }

  .widget-hero .project-header {
    margin-bottom: 0;
  }

  .daily-poster-container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding-top: 40px; 
    padding-bottom: 60px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .project-title {
    font-size: 3rem;
    font-weight: 800;
    margin: 0;
    color: #111;
    letter-spacing: -0.03em;
  }

  /* Grid Layout: 3 columns across on desktop */
  .poster-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px; 
    width: 100%;
  }

  .poster-item {
    width: 100%;
  }

  /* Target the img generated by Astro's <Image /> component */
  .poster-item img {
    width: 100%;
    height: auto;
    display: block;
    background-color: #f0f0f0; 
    border-radius: 4px; 
  }

  /* Mobile Layout */
  @media (max-width: 768px) {
    .widget-hero {
      height: auto;
      padding-top: 100px;
      padding-left: 20px;
      padding-right: 20px;
      justify-content: flex-start;
    }
    .widget-wrapper {
      display: none;
    }
    .widget-hero .project-header {
      margin-bottom: 40px;
    }
    .poster-grid {
      grid-template-columns: 1fr;
    }
    .daily-poster-container {
      padding-top: 0;
    }
  }
</style>>