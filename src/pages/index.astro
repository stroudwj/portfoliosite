---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Load some art and poster images for the collage
const artFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/art/*.{jpeg,jpg,png,gif,webp}', { eager: true });
const posterFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/daily-poster/*.{jpeg,jpg,png,gif,webp}', { eager: true });

const artImages = Object.values(artFiles).map(file => file.default).slice(0, 6);
const posterImages = Object.values(posterFiles).map(file => file.default).slice(0, 6);

// Interleave them for the collage
const collageImages = [];
const maxLength = Math.max(artImages.length, posterImages.length);
for (let i = 0; i < maxLength; i++) {
  if (artImages[i]) collageImages.push(artImages[i]);
  if (posterImages[i]) collageImages.push(posterImages[i]);
}
---

<Layout title="Home — Portfolio">
  <div class="page-header">
    <h1 class="page-title">Selected Works</h1>
  </div>

  <div class="collage-container">
    <div class="masonry-grid">
      {collageImages.map((img) => (
        <div class="masonry-item">
          <Image src={img} alt="Portfolio Item" width={600} />
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-header {
    padding: 60px;
    margin-bottom: 0;
  }
  
  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: #111;
    margin: 0;
    letter-spacing: -0.02em;
    text-align: right;
  }

  .collage-container {
    padding: 20px 40px 60px;
  }

  .masonry-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start; 
  }

  @media (min-width: 640px) {
    .masonry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1536px) {
    .masonry-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .masonry-item {
    width: 100%;
  }

  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .masonry-item img:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.15);
  }

  /* Mobile-specific padding adjustments */
  @media (max-width: 768px) {
    .page-header {
      padding: 60px 20px; /* Adjust top/bottom and left/right padding for the header on mobile */
    }
    .collage-container {
      padding: 80px 20px 40px; /* Adjust top/bottom and left/right padding for the image collage on mobile */
    }
  }
</style>